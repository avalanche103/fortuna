{
  "name": "fcfortuna",
  "version": "1.0.0",
  "description": "Сайт ФК Фортуна — fcfortuna.by",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-schema.js",
    "start": "tsx src/index.ts",
    "ispmanager-custom-command": "node app.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:import": "tsx src/db/import.ts",
    "db:download-photos": "tsx src/db/download-photos.ts",
    "db:set-admin": "tsx scripts/set-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^7.2.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.8.2"
  }
}
