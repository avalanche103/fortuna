<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | fcfortuna.by</title>
  <%- include('../partials/social-meta') %>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,700&family=Oswald:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../partials/masthead') %>
  <main>
    <div class="page-header"><div class="container"><h1><%= title %></h1></div></div>
    <div class="container section" style="padding-top:0;">
      <%
        const formatWord = (word) => {
          const w = String(word ?? '').replace(/\u00a0/g, ' ').trim();
          if (!w) return '';
          const lower = w.toLowerCase();
          return lower.charAt(0).toUpperCase() + lower.slice(1);
        };
        const formatWords = (value) => {
          const raw = String(value ?? '').replace(/\u00a0/g, ' ').trim();
          if (!raw) return '';
          return raw
            .split(/\s+/)
            .filter(Boolean)
            .map(formatWord)
            .join(' ');
        };
      %>
      <% if (group.photo) { %>
        <div class="group-block__photo-wrap">
          <img class="group-block__photo" src="<%= group.photo %>" alt="<%= group.name %>">
        </div>
      <% } %>
      <ul class="group-players-list">
        <% players.forEach(function(p, index) { %>
          <li class="group-players-list__item">
            <% const parts = splitPlayerName(p.name || ''); %>
            <% const surname = formatWord(parts.surname); %>
            <% const firstName = formatWords(parts.firstName); %>
            <% const playerNumber = p.number != null ? p.number : (index + 1); %>
            <span class="group-players-list__num"><%= playerNumber %></span>
            <a class="group-players-list__name group-players-list__link" href="/player/<%= p.slug %>">
              <%= surname %><% if (firstName) { %> <%= firstName %><% } %>
            </a>
            <span class="group-players-list__date"><%= p.birth_date || '—' %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
