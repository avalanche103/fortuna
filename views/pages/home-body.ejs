<section class="home-hero" aria-labelledby="home-hero-title" hidden>
  <div class="container home-hero__inner">
    <div class="home-hero__brand">
      <div class="home-hero__emblem">
        <img
          class="home-hero__logo"
          src="/images/logo-1.png"
          alt="Эмблема футбольного клуба «Фортуна» Минск"
          width="447"
          height="447"
          fetchpriority="high"
        >
        <img
          class="home-hero__ball"
          src="/images/ball.gif"
          alt=""
          aria-hidden="true"
          loading="eager"
        >
      </div>
      <div class="home-hero__text">
        <p class="home-hero__club">
          <span class="home-hero__club-line home-hero__club-line--top">Футбольный клуб</span>
          <span class="home-hero__club-line home-hero__club-line--main">
            <span class="home-hero__club-name">«Фортуна»</span>
            <span class="home-hero__club-city">Минск</span>
          </span>
        </p>
        <h1 id="home-hero-title" class="home-hero__title">
          <span class="home-hero__quote-line home-hero__quote-line--1">Твой свет не дойдет до каждого,</span>
          <span class="home-hero__quote-line home-hero__quote-line--2">Но он обязательно коснется тех,</span>
          <span class="home-hero__quote-line home-hero__quote-line--3">Кто ищет именно его</span>
        </h1>
      </div>
    </div>
  </div>
</section>

<div class="section">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Новости</h2>
      <a href="/blog" class="btn btn--outline">Все новости</a>
    </div>
    <div class="news-grid news-grid--home">
      <% if (recruitmentNews) { %>
        <% const recruitmentUrl = '/blog/' + recruitmentNews.category + '/' + recruitmentNews.slug; %>
        <% const recruitmentImg = getNewsCoverImage(recruitmentNews); %>
        <% const recruitmentExcerpt = getNewsExcerpt(recruitmentNews, 180); %>
        <article class="news-item news-item--compact">
          <a href="<%= recruitmentUrl %>" class="news-item__thumb-link">
            <% if (recruitmentImg) { %>
              <img class="news-item__cover news-item__cover--small" src="<%= recruitmentImg %>" alt="<%= recruitmentNews.title %>" loading="lazy">
            <% } else { %>
              <div class="news-item__cover news-item__cover--small news-item__cover--placeholder"></div>
            <% } %>
          </a>
          <div class="news-item__body">
            <h3 class="news-item__title">
              <a href="<%= recruitmentUrl %>"><%= recruitmentNews.title %></a>
            </h3>
            <p class="news-item__excerpt"><%= recruitmentExcerpt || '' %></p>
            <a href="<%= recruitmentUrl %>" class="news-item__more">Смотреть дальше</a>
          </div>
        </article>
      <% } else { %>
        <article class="news-item news-item--compact">
          <div class="news-item__body">
            <h3 class="news-item__title">Новость про набор не настроена</h3>
            <p class="news-item__excerpt">Создайте или отредактируйте новость в админке с категорией <strong>nabor</strong>.</p>
          </div>
        </article>
      <% } %>

      <% news.forEach(function(item) { %>
        <% const itemUrl = '/blog/' + item.category + '/' + item.slug; %>
        <% const itemImg = getNewsCoverImage(item); %>
        <% const excerpt = getNewsExcerpt(item, 180); %>
        <article class="news-item news-item--compact">
          <a href="<%= itemUrl %>" class="news-item__thumb-link">
            <% if (itemImg) { %>
              <img class="news-item__cover news-item__cover--small" src="<%= itemImg %>" alt="<%= item.title %>" loading="lazy">
            <% } else { %>
              <div class="news-item__cover news-item__cover--small news-item__cover--placeholder"></div>
            <% } %>
          </a>
          <div class="news-item__body">
            <h3 class="news-item__title">
              <a href="<%= itemUrl %>"><%= item.title %></a>
            </h3>
            <p class="news-item__excerpt"><%= excerpt || '' %></p>
            <a href="<%= itemUrl %>" class="news-item__more">Смотреть дальше</a>
          </div>
        </article>
      <% }); %>
    </div>

    <div class="home-widgets">
      <div class="widget widget--recruitment">
        <h3 class="widget__title"><%= recruitment.title %></h3>
        <% if (recruitment.subtitle) { %>
          <p class="widget-recruitment__subtitle"><%= recruitment.subtitle %></p>
        <% } %>
        <% if (recruitment.teaser) { %>
          <div class="widget-recruitment__body"><%= recruitment.teaser %></div>
        <% } %>
        <a href="/nabor" class="btn btn--primary widget-recruitment__btn">Почему именно к нам?</a>
        <% if (recruitment.phones) { %>
          <div class="widget-recruitment__phone"><%= recruitment.phones %></div>
        <% } %>
      </div>

      <div class="widget widget--birthdays">
        <h3 class="widget__title">Наши именинники</h3>
        <div class="birthday-festive" aria-hidden="true">
          <svg class="birthday-festive__bouquet" viewBox="0 0 80 88" width="44" height="48" focusable="false">
            <ellipse class="birthday-festive__bloom birthday-festive__bloom--a" cx="28" cy="28" rx="14" ry="16" />
            <ellipse class="birthday-festive__bloom birthday-festive__bloom--b" cx="48" cy="22" rx="13" ry="15" />
            <ellipse class="birthday-festive__bloom birthday-festive__bloom--c" cx="58" cy="38" rx="12" ry="14" />
            <ellipse class="birthday-festive__bloom birthday-festive__bloom--d" cx="38" cy="40" rx="11" ry="13" />
            <circle cx="28" cy="28" r="4" fill="#f7e08a" />
            <circle cx="48" cy="22" r="3.5" fill="#f7e08a" />
            <circle cx="58" cy="38" r="3.5" fill="#f7e08a" />
            <path d="M36 48 C34 62 30 74 28 84 M42 50 C44 64 48 74 52 84 M40 48 C40 62 40 72 40 84" stroke="#2f6b3a" stroke-width="2.2" fill="none" stroke-linecap="round" />
            <path d="M24 58 C32 54 48 54 56 60 C48 68 32 68 24 58Z" fill="#900808" />
            <path d="M28 62 H52" stroke="#f7e08a" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="birthday-festive__cake" viewBox="0 0 88 78" width="48" height="42" focusable="false">
            <g class="birthday-festive__candle">
              <rect x="28" y="8" width="4" height="16" rx="1" fill="#f4d35e" />
              <path class="birthday-festive__flame" d="M30 2 C33 6 33 9 30 11 C27 9 27 6 30 2Z" />
            </g>
            <g class="birthday-festive__candle">
              <rect x="42" y="4" width="4" height="20" rx="1" fill="#f4d35e" />
              <path class="birthday-festive__flame birthday-festive__flame--delay" d="M44 0 C47 4 47 7 44 9 C41 7 41 4 44 0Z" />
            </g>
            <g class="birthday-festive__candle">
              <rect x="56" y="8" width="4" height="16" rx="1" fill="#f4d35e" />
              <path class="birthday-festive__flame" d="M58 2 C61 6 61 9 58 11 C55 9 55 6 58 2Z" />
            </g>
            <rect x="14" y="24" width="60" height="16" rx="4" fill="#fff6ea" stroke="#d8b48a" stroke-width="1.5" />
            <path d="M18 32 C24 28 30 36 36 32 C42 28 48 36 54 32 C60 28 66 34 70 30" stroke="#900808" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <rect x="10" y="40" width="68" height="22" rx="5" fill="#f3c98b" />
            <rect x="10" y="56" width="68" height="14" rx="4" fill="#c47a3a" />
            <circle cx="24" cy="50" r="2.2" fill="#900808" />
            <circle cx="44" cy="48" r="2.2" fill="#1a3a8f" />
            <circle cx="64" cy="51" r="2.2" fill="#900808" />
          </svg>
        </div>
        <p class="birthday-wish">
          Поздравляем с Днем рождения наших юных футболистов и шлем им
          пожелания крепкого здоровья, радостей, удач и успехов в постижении тайн любимой игры!
        </p>
        <% if (birthdays.length === 0) { %>
          <p class="widget__empty">В этом месяце именинников нет.</p>
        <% } else { %>
          <% const todayMd = String(new Date().getDate()).padStart(2, '0') + '.' + String(new Date().getMonth() + 1).padStart(2, '0'); %>
          <ul class="birthday-list">
            <% birthdays.forEach(function(p) { %>
              <% const isToday = p.birth_date && String(p.birth_date).slice(0, 5) === todayMd; %>
              <li class="<%= isToday ? 'birthday-list__item--today' : '' %>">
                <span><%= p.name %></span>
                <span class="date"><%= p.birth_date %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>

      <div class="widget widget--song">
        <h3 class="widget__title">Песня «ФК «Фортуна»</h3>
        <dl class="song-credits">
          <div><dt>Слова</dt><dd>Юрий Антипов</dd></div>
          <div><dt>Музыка</dt><dd>Альберт Скороход</dd></div>
          <div><dt>Исполняет</dt><dd>Альберт Скороход</dd></div>
        </dl>
        <div class="song-player">
          <audio controls preload="metadata" controlslist="nodownload">
            <source src="/audio/fortuna-song.mp3" type="audio/mpeg">
            Ваш браузер не поддерживает воспроизведение аудио.
          </audio>
        </div>
      </div>
    </div>
  </div>
</div>

<section class="section" id="fortuna-tv" style="padding-top:0;">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">FC Fortuna TV</h2>
      <a href="/tv" class="btn btn--outline">Все видео</a>
    </div>
    <% if (videos.length === 0) { %>
      <p>Видео пока не добавлены.</p>
    <% } else { %>
      <% const videosPerPage = 3; %>
      <% const videoPageCount = Math.ceil(videos.length / videosPerPage); %>
      <div class="video-carousel" id="video-carousel" data-per-page="<%= videosPerPage %>">
        <div class="video-carousel__viewport">
          <% for (let page = 0; page < videoPageCount; page++) { %>
            <div class="video-carousel__page<%= page === 0 ? ' is-active' : '' %>" data-page="<%= page %>">
              <div class="video-grid">
                <% videos.slice(page * videosPerPage, page * videosPerPage + videosPerPage).forEach(function(v) { %>
                  <a href="<%= v.youtube_url %>" target="_blank" rel="noopener" class="card video-card">
                    <img class="video-card__thumb" src="<%= youtubeThumb(v.youtube_url) %>" alt="<%= v.title %>" loading="lazy">
                    <div class="video-card__title"><%= v.title %></div>
                  </a>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
        <% if (videoPageCount > 1) { %>
          <div class="video-carousel__nav">
            <button type="button" class="video-carousel__btn video-carousel__btn--prev" aria-label="Предыдущие видео">‹</button>
            <div class="video-carousel__dots">
              <% for (let page = 0; page < videoPageCount; page++) { %>
                <button type="button" class="video-carousel__dot<%= page === 0 ? ' is-active' : '' %>" data-page="<%= page %>" aria-label="Страница <%= page + 1 %>"></button>
              <% } %>
            </div>
            <button type="button" class="video-carousel__btn video-carousel__btn--next" aria-label="Следующие видео">›</button>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Воспитанники</h2>
      <a href="/vospitanniki" class="btn btn--outline">Перейти в раздел</a>
    </div>
    <% const graduatesPerPage = 6; %>
    <% const graduatesPageCount = Math.ceil(graduates.length / graduatesPerPage); %>
    <div class="video-carousel graduates-carousel" id="graduates-carousel" data-per-page="<%= graduatesPerPage %>">
      <div class="video-carousel__viewport">
        <% for (let page = 0; page < graduatesPageCount; page++) { %>
          <div class="video-carousel__page<%= page === 0 ? ' is-active' : '' %>" data-page="<%= page %>">
            <div class="players-grid players-grid--graduates players-grid--graduates-carousel">
              <% graduates.slice(page * graduatesPerPage, page * graduatesPerPage + graduatesPerPage).forEach(function(p) { %>
                <% const nameParts = splitPlayerName(p.name); %>
                <a href="/vospitanniki/<%= p.slug %>" class="player-card">
                  <% if (p.photo) { %>
                    <img class="player-card__photo" src="<%= p.photo %>" alt="<%= p.name %>">
                  <% } else { %>
                    <div class="player-card__photo player-card__photo--placeholder"><%= nameParts.surname.charAt(0) %></div>
                  <% } %>
                  <%- include('../partials/player-name', { name: p.name }) %>
                  <% if (p.club) { %><div class="player-card__meta"><%= p.club %></div><% } %>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
      <% if (graduatesPageCount > 1) { %>
        <div class="video-carousel__nav">
          <button type="button" class="video-carousel__btn video-carousel__btn--prev" aria-label="Предыдущие воспитанники">‹</button>
          <div class="video-carousel__dots">
            <% for (let page = 0; page < graduatesPageCount; page++) { %>
              <button type="button" class="video-carousel__dot<%= page === 0 ? ' is-active' : '' %>" data-page="<%= page %>" aria-label="Страница <%= page + 1 %>"></button>
            <% } %>
          </div>
          <button type="button" class="video-carousel__btn video-carousel__btn--next" aria-label="Следующие воспитанники">›</button>
        </div>
      <% } %>
    </div>
  </div>
</section>
