<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | fcfortuna.by</title>
  <%- include('../partials/social-meta') %>
  <%- include('../partials/fonts') %>
  <link rel="stylesheet" href="/css/main.css?v=20260824e">
</head>
<body>
  <%- include('../partials/masthead') %>
  <main id="main-content">
    <div class="page-header"><div class="container"><h1><%= title %></h1></div></div>
    <div class="container section vizitka-page" style="padding-top:0;">
      <% const intro = sections.find(function(s) { return s.sort_order === 1; }) || sections[0]; %>
      <% const arena = sections.find(function(s) { return s.sort_order === 2; }); %>

      <% if (intro) { %>
        <article class="card vizitka-intro">
          <h2 class="vizitka-intro__title">
            <% const fortunaMark = '«ФОРТУНА»'; %>
            <% const fortunaAt = intro.title.indexOf(fortunaMark); %>
            <% if (fortunaAt > 0) { %>
              <span class="vizitka-intro__title-line"><%= intro.title.slice(0, fortunaAt).trim() %></span>
              <span class="vizitka-intro__title-line"><%= intro.title.slice(fortunaAt).trim() %></span>
            <% } else { %>
              <%= intro.title %>
            <% } %>
          </h2>
          <div class="vizitka-intro__logo-wrap">
            <img
              class="vizitka-intro__logo"
              src="/images/footer-trademark.png"
              alt="Эмблема ФК «Фортуна»"
              width="50"
              height="67"
            >
          </div>
          <div class="vizitka-intro__body"><%= intro.body %></div>
        </article>
      <% } %>

      <% if (coaches.length > 0) { %>
        <div class="vizitka-coaches">
          <% coaches.forEach(function(coach) { %>
            <article class="vizitka-coach card">
              <% if (coach.photo) { %>
                <img class="vizitka-coach__photo" src="<%= coach.photo %>" alt="<%= coach.name %>" loading="lazy">
              <% } %>
              <% if (coach.role) { %>
                <p class="vizitka-coach__role"><%= coach.role %></p>
              <% } %>
              <h3 class="vizitka-coach__name"><%= coach.name %></h3>
              <% if (coach.bio) { %>
                <div class="vizitka-coach__bio"><%= coach.bio %></div>
              <% } %>
            </article>
          <% }); %>
        </div>
      <% } %>

      <% if (arena) { %>
        <article class="card vizitka-arena">
          <% if (arena.image) { %>
            <img class="vizitka-arena__photo" src="<%= arena.image %>" alt="Стадион «Зелёный луг»" loading="lazy">
          <% } %>
          <p class="vizitka-arena__text"><%= arena.body %></p>
        </article>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
