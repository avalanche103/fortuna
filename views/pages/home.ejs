<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | fcfortuna.by</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,700&family=Oswald:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="page-home">
  <%- include('../partials/ticker') %>
  <%- include('../partials/header') %>
  <main>
    <%# Hero hidden — restore: include('../partials/home-hero-v1') %>
    <%- include('home-body') %>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function initHomeCarousels() {
      function initCarousel(carouselId) {
        const carousel = document.getElementById(carouselId);
        if (!carousel) return;

        const pages = [...carousel.querySelectorAll('.video-carousel__page')];
        const dots = [...carousel.querySelectorAll('.video-carousel__dot')];
        const prevBtn = carousel.querySelector('.video-carousel__btn--prev');
        const nextBtn = carousel.querySelector('.video-carousel__btn--next');
        if (pages.length <= 1) return;

        let current = 0;

        function showPage(index) {
          current = (index + pages.length) % pages.length;
          pages.forEach((page, i) => page.classList.toggle('is-active', i === current));
          dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
        }

        prevBtn?.addEventListener('click', () => showPage(current - 1));
        nextBtn?.addEventListener('click', () => showPage(current + 1));
        dots.forEach((dot) => {
          dot.addEventListener('click', () => showPage(parseInt(dot.dataset.page ?? '0', 10)));
        });
      }

      initCarousel('video-carousel');
      initCarousel('graduates-carousel');
    })();

    (function syncHomeWidgetHeights() {
      const row = document.querySelector('.home-widgets');
      if (!row) return;

      const widgets = [...row.querySelectorAll('.widget')];
      const reference = row.querySelector('.widget--recruitment');
      if (!reference) return;

      function applyHeights() {
        widgets.forEach((widget) => {
          widget.style.height = '';
        });

        if (window.matchMedia('(max-width: 900px)').matches) return;

        const height = reference.offsetHeight;
        widgets.forEach((widget) => {
          widget.style.height = `${height}px`;
        });
      }

      applyHeights();
      window.addEventListener('resize', applyHeights);
      if ('ResizeObserver' in window) {
        new ResizeObserver(applyHeights).observe(reference);
      }
    })();
  </script>
</body>
</html>
