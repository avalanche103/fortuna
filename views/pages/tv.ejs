<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | fcfortuna.by</title>
  <%- include('../partials/social-meta') %>
  <%- include('../partials/fonts') %>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../partials/masthead') %>
  <main id="main-content">
    <div class="container section tv-page">
      <div class="section__header">
        <h1 class="section__title">
          <a href="https://www.youtube.com/@fortunatvbelarus8681" target="_blank" rel="noopener">FORTUNA TV</a>
        </h1>
        <a class="btn btn--outline" href="https://www.youtube.com/@fortunatvbelarus8681" target="_blank" rel="noopener">YouTube</a>
      </div>
      <% if (videos.length === 0) { %>
        <p>Видео пока не добавлены.</p>
      <% } else { %>
        <div class="video-grid">
          <% videos.forEach(function(v) { %>
            <a href="<%= v.youtube_url %>" target="_blank" rel="noopener" class="card video-card">
              <img class="video-card__thumb" src="<%= youtubeThumb(v.youtube_url) %>" alt="<%= v.title %>" loading="lazy">
              <div class="video-card__title"><%= v.title %></div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
