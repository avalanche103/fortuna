<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | fcfortuna.by</title>
  <%- include('../partials/social-meta') %>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,700&family=Oswald:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../partials/masthead') %>
  <main>
    <div class="page-header"><div class="container">
      <h1>Расписание · <%= monthName %> <%= displayYear %></h1>
    </div></div>
    <div class="container section schedule-page">
      <nav class="schedule-months" aria-label="Выбор месяца">
        <% months.forEach(function(item) { %>
          <a class="<%= month && item.id === month.id ? 'active' : '' %>"
             href="/raspisanie?year=<%= item.year %>&month=<%= item.month %><%= selectedGroup ? '&group=' + selectedGroup.slug : '' %>">
            <%= MONTH_NAMES[item.month - 1] %> <%= item.year %>
          </a>
        <% }); %>
      </nav>

      <nav class="schedule-groups" aria-label="Выбор группы">
        <a class="schedule-groups__all <%= selectedGroup ? '' : 'active' %>" href="/raspisanie?year=<%= displayYear %>&month=<%= displayMonth %>">Все группы</a>
        <% allGroups.forEach(function(group) { %>
          <a class="<%= selectedGroup && selectedGroup.id === group.id ? 'active' : '' %>"
             href="/raspisanie?year=<%= displayYear %>&month=<%= displayMonth %>&group=<%= group.slug %>"><%= group.name %></a>
        <% }); %>
      </nav>

      <% if (!selectedGroup) { %>
        <div class="schedule-empty schedule-empty--mobile-only">
          <h2>Выберите группу</h2>
        </div>
      <% } %>

      <% if (!month || entries.length === 0) { %>
        <div class="schedule-empty <%= selectedGroup ? '' : 'schedule-empty--desktop-only' %>">
          <h2>Расписание пока не опубликовано</h2>
          <p><%= selectedGroup ? 'Для выбранной группы в этом месяце занятий нет.' : 'Выберите другой месяц или загляните позже.' %></p>
        </div>
      <% } else {
        const entryBySlot = new Map();
        entries.forEach(function(entry) { entryBySlot.set(entry.day + ':' + entry.group_id, entry); });
      %>
        <div class="schedule-table-wrap <%= selectedGroup ? 'has-group-filter' : 'schedule-table-wrap--desktop-only' %>">
          <table class="schedule-table">
            <thead>
              <tr>
                <th scope="col">Дата</th>
                <% groups.forEach(function(group) { %><th scope="col"><%= group.name %></th><% }); %>
              </tr>
            </thead>
            <tbody>
              <% for (let day = firstVisibleDay; day <= daysInMonth; day += 1) {
                const date = new Date(Date.UTC(displayYear, displayMonth - 1, day));
                const weekday = new Intl.DateTimeFormat('ru-RU', { weekday: 'long', timeZone: 'UTC' }).format(date);
              %>
                <tr>
                  <th scope="row" class="day-cell"><strong><%= day %></strong><small><%= weekday %></small></th>
                  <% groups.forEach(function(group) {
                    const slot = entryBySlot.get(day + ':' + group.id);
                    const isDouble = slot && Number(slot.is_double) === 1;
                    const color = slot && slot.location_color ? slot.location_color : '#6b7280';
                    const color2 = slot && slot.location_color_2 ? slot.location_color_2 : color;
                  %>
                    <td class="schedule-cell <%= slot ? 'has-session' : '' %> <%= isDouble ? 'has-double' : '' %>"
                        <% if (slot) { %>style="--location-color:<%= color %>;--location-text:<%= scheduleTextColor(color) %>"<% } %>>
                      <% if (slot) { %>
                        <article class="schedule-session <%= isDouble ? 'schedule-session--double' : '' %>">
                          <div class="schedule-session__shift" style="--location-color:<%= color %>;--location-text:<%= scheduleTextColor(color) %>">
                            <% if (slot.time_start) { %>
                              <strong class="schedule-session__time"><%= slot.time_start %><%= slot.time_end ? '–' + slot.time_end : '' %></strong>
                            <% } %>
                            <span class="schedule-session__location"><%= slot.location_name || 'Площадка не указана' %></span>
                            <% if (slot.note) { %><span class="schedule-session__note"><%= slot.note %></span><% } %>
                          </div>
                          <% if (isDouble) { %>
                            <div class="schedule-session__shift" style="--location-color:<%= color2 %>;--location-text:<%= scheduleTextColor(color2) %>">
                              <% if (slot.time_start_2) { %>
                                <strong class="schedule-session__time"><%= slot.time_start_2 %><%= slot.time_end_2 ? '–' + slot.time_end_2 : '' %></strong>
                              <% } %>
                              <span class="schedule-session__location"><%= slot.location_name_2 || 'Площадка не указана' %></span>
                              <% if (slot.note_2) { %><span class="schedule-session__note"><%= slot.note_2 %></span><% } %>
                            </div>
                          <% } %>
                        </article>
                      <% } else { %>
                        <span class="schedule-cell__empty" aria-label="Занятий нет">—</span>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <% if (selectedGroup) { %>
          <div class="schedule-mobile-list">
            <% entries.forEach(function(slot) {
              const date = new Date(Date.UTC(displayYear, displayMonth - 1, slot.day));
              const dateLabel = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', weekday: 'short', timeZone: 'UTC' }).format(date);
              const isDouble = Number(slot.is_double) === 1;
              const color = slot.location_color || '#6b7280';
              const color2 = slot.location_color_2 || color;
              const sameVenue = !isDouble || String(slot.location_id || '') === String(slot.location_id_2 || '');
            %>
              <article class="schedule-mobile-card <%= isDouble ? 'schedule-mobile-card--double' : '' %> <%= isDouble && sameVenue ? 'is-same-venue' : '' %> <%= isDouble && !sameVenue ? 'is-split-venue' : '' %>"
                       style="--location-color:<%= color %>;--location-text:<%= scheduleTextColor(color) %>;--location-color-2:<%= color2 %>;--location-text-2:<%= scheduleTextColor(color2) %>">
                <div class="schedule-mobile-card__date"><%= dateLabel %></div>
                <div class="schedule-mobile-card__content">
                  <div class="schedule-mobile-card__shift" style="--location-color:<%= color %>;--location-text:<%= scheduleTextColor(color) %>">
                    <% if (slot.time_start) { %><strong><%= slot.time_start %><%= slot.time_end ? '–' + slot.time_end : '' %></strong><% } %>
                    <span><%= slot.location_name || 'Площадка не указана' %></span>
                    <% if (slot.note) { %><span><%= slot.note %></span><% } %>
                  </div>
                  <% if (isDouble) { %>
                    <div class="schedule-mobile-card__shift" style="--location-color:<%= color2 %>;--location-text:<%= scheduleTextColor(color2) %>">
                      <% if (slot.time_start_2) { %><strong><%= slot.time_start_2 %><%= slot.time_end_2 ? '–' + slot.time_end_2 : '' %></strong><% } %>
                      <span><%= slot.location_name_2 || 'Площадка не указана' %></span>
                      <% if (slot.note_2) { %><span><%= slot.note_2 %></span><% } %>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        <% } %>
      <% } %>

      <% if (locations.length) { %>
        <section class="schedule-legend">
          <h2>Места проведения</h2>
          <ul>
            <% locations.forEach(function(location) { %>
              <li>
                <span class="schedule-location__dot" style="--location-color:<%= location.color %>"></span>
                <span><strong><%= location.name %></strong><%= location.address ? ' — ' + location.address : '' %></span>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
