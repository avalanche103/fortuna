<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,700&family=Oswald:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <div class="admin-main">
      <h1><%= title %></h1>
      <form class="form-card form-card--wide" method="post" action="<%= article ? '/admin/news/' + article.id : '/admin/news' %>" id="news-form">
        <div class="form-group">
          <label>Заголовок</label>
          <input type="text" name="title" value="<%= article ? article.title : '' %>" required>
        </div>
        <div class="form-group">
          <label>Категория (для URL)</label>
          <input type="text" name="category" value="<%= article ? article.category : 'novosti' %>">
        </div>
        <div class="form-group">
          <label>Краткое описание</label>
          <textarea name="excerpt"><%= article ? (article.excerpt || '') : '' %></textarea>
        </div>
        <div class="form-group">
          <label for="cover-catcher">Заглавная картинка</label>
          <input type="hidden" name="cover_image" id="cover-image-input" value="<%= coverImage || '' %>">
          <div class="cover-paste" id="cover-paste">
            <textarea class="cover-paste__catcher" id="cover-catcher" aria-label="Вставить заглавную картинку из буфера обмена"></textarea>
            <div class="cover-paste__empty" id="cover-empty" <%= coverImage ? 'hidden' : '' %>>
              <p class="cover-paste__title">Вставьте картинку или выберите файл</p>
              <p class="cover-paste__hint">Ctrl+V / Cmd+V из буфера или выберите файл. Большие фото сжимаются сами</p>
            </div>
            <div class="cover-paste__filled" id="cover-filled" <%= coverImage ? '' : 'hidden' %>>
              <img id="cover-preview" src="<%= coverImage || '' %>" alt="Заглавная картинка">
              <p class="cover-paste__hint">Вставьте другую картинку (Ctrl+V) или выберите файл</p>
            </div>
            <div class="cover-paste__actions">
              <button type="button" class="btn btn--outline" id="cover-browse">Выбрать файл</button>
              <button type="button" class="btn btn--outline cover-paste__remove" id="cover-remove" <%= coverImage ? '' : 'hidden' %>>Убрать</button>
            </div>
            <input type="file" id="cover-file-input" accept="image/jpeg,image/png,image/gif,image/webp,image/*" hidden>
            <p class="cover-paste__status" id="cover-status" hidden></p>
          </div>
        </div>
        <div class="form-group" hidden>
          <label>Картинки</label>
          <div class="image-dropzone" id="image-dropzone">
            <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/gif,image/webp" multiple hidden>
            <p class="image-dropzone__title">Перетащите изображения сюда</p>
            <p class="image-dropzone__hint">или <button type="button" class="image-dropzone__browse" id="image-browse-btn">выберите файлы</button></p>
            <p class="image-dropzone__status" id="image-dropzone-status" hidden></p>
          </div>
          <div class="image-dropzone__previews" id="image-previews"></div>
        </div>
        <div class="form-group">
          <label>Текст</label>
          <div class="news-editor-toolbar" id="news-editor-toolbar">
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="paragraph">Абзац</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="line-break">Перенос</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="h2">H2</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="h3">H3</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="link">Ссылка</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="youtube">YouTube</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="reel">Reels</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="ul">Список UL</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="ol">Список OL</button>
            <button type="button" class="btn btn--outline news-editor-toolbar__btn" data-action="quote">Цитата</button>
          </div>
          <textarea name="body" id="news-body" style="min-height:240px;" required><%= article ? bodyHtml : '' %></textarea>
          <p class="form-hint">Можно вставить картинку из буфера (Ctrl+V) или перетащить файл в поле текста. YouTube — обычное видео. Reels — Instagram, YouTube Shorts или Facebook.</p>
          <p class="cover-paste__status" id="news-body-status" hidden></p>
        </div>
        <div class="form-group">
          <label>Дата публикации</label>
          <input type="datetime-local" name="published_at" value="<%= article ? article.published_at.replace(' ', 'T').substring(0,16) : '' %>" required>
        </div>
        <div class="form-check">
          <input type="checkbox" name="is_pinned" id="is_pinned" <%= article && article.is_pinned ? 'checked' : '' %>>
          <label for="is_pinned">Закрепить</label>
        </div>
        <div class="btn-group">
          <button type="submit" class="btn btn--primary">Сохранить</button>
          <a href="/admin/news" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
  <script src="/js/admin-news-images.js"></script>
</body>
</html>
