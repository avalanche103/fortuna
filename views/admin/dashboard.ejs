<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,700&family=Oswald:wght@600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <div class="admin-main">
      <h1><%= title %></h1>
      <section class="ga-widget">
        <div class="ga-widget__head">
          <div>
            <h2 class="ga-widget__title">Google Analytics</h2>
            <p class="ga-widget__subtitle">Посещения за сегодня</p>
          </div>
          <a href="/admin/analytics" class="btn btn--outline">Открыть аналитику</a>
        </div>
        <% if (!analytics.configured) { %>
          <p class="ga-widget__empty">Подключите доступ к GA4 в разделе «Аналитика», чтобы видеть посещения.</p>
        <% } else if (analytics.error) { %>
          <p class="ga-widget__empty"><%= analytics.error %></p>
        <% } else { %>
          <div class="ga-widget__stats">
            <div>
              <div class="ga-widget__value"><%= formatGaNumber(analytics.sessions) %></div>
              <div class="ga-widget__label">Посещений сегодня</div>
            </div>
            <div>
              <div class="ga-widget__value"><%= formatGaNumber(analytics.newUsers) %></div>
              <div class="ga-widget__label">Новых сегодня</div>
            </div>
          </div>
        <% } %>
      </section>
      <div class="admin-stats">
        <div class="stat-card"><div class="stat-card__value"><%= stats.news %></div><div class="stat-card__label">Новостей</div></div>
        <div class="stat-card"><div class="stat-card__value"><%= stats.players %></div><div class="stat-card__label">Игроков</div></div>
        <div class="stat-card"><div class="stat-card__value"><%= stats.graduates %></div><div class="stat-card__label">Воспитанников</div></div>
        <div class="stat-card"><div class="stat-card__value"><%= stats.groups %></div><div class="stat-card__label">Групп</div></div>
        <div class="stat-card"><div class="stat-card__value"><%= stats.schedule %></div><div class="stat-card__label">Месяцев расписания</div></div>
        <div class="stat-card"><div class="stat-card__value"><%= stats.videos %></div><div class="stat-card__label">Видео</div></div>
      </div>
      <div class="btn-group">
        <a href="/admin/news/new" class="btn btn--primary">+ Новость</a>
        <a href="/admin/players/new" class="btn btn--secondary">+ Игрок</a>
        <a href="/admin/graduates/new" class="btn btn--secondary">+ Воспитанник</a>
        <a href="/admin/schedule" class="btn btn--secondary">Расписание</a>
        <a href="/admin/settings" class="btn btn--outline">Текст набора</a>
      </div>
    </div>
  </div>
</body>
</html>
