<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('../partials/fonts') %>
  <%- include('../partials/admin-favicon') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <div class="admin-main">
      <h1><%= title %></h1>
      <div class="form-card">
      <form method="post" enctype="multipart/form-data" action="<%= player ? '/admin/players/' + player.id : '/admin/players' %>">
        <input type="hidden" name="is_graduate" value="<%= kind === 'graduate' ? '1' : '' %>">
        <div class="form-group">
          <label>ФИО</label>
          <input type="text" name="name" value="<%= player ? player.name : '' %>" required>
        </div>
        <div class="form-group">
          <label>Дата рождения (ДД.ММ.ГГГГ)</label>
          <input type="text" name="birth_date" value="<%= player ? (player.birth_date || '') : '' %>">
        </div>
        <div class="form-group">
          <label>Амплуа</label>
          <input type="text" name="position" value="<%= player ? (player.position || '') : '' %>">
        </div>
        <% if (kind === 'graduate') { %>
          <div class="form-group">
            <label>Клуб</label>
            <input type="text" name="club" value="<%= player ? (player.club || '') : '' %>">
          </div>
        <% } %>
        <div class="form-group">
          <label>Биография</label>
          <textarea name="bio" class="js-word-editor" data-mode="text"><%= player ? (player.bio || '') : '' %></textarea>
        </div>
        <div class="form-group">
          <label>Фото</label>
          <input type="file" name="photo" accept="image/*">
        </div>
        <% if (kind === 'player') { %>
          <div class="form-group">
            <label>Группы</label>
            <% groups.forEach(function(g) { %>
              <div class="form-check">
                <input type="checkbox" name="group_ids" value="<%= g.id %>" id="g<%= g.id %>"
                  <%= player && player.groupIds && player.groupIds.includes(g.id) ? 'checked' : '' %>>
                <label for="g<%= g.id %>"><%= g.name %></label>
              </div>
            <% }); %>
          </div>
          <div class="form-check">
            <input type="checkbox" name="is_chudo_master" id="is_chudo_master" <%= player && player.is_chudo_master ? 'checked' : '' %>>
            <label for="is_chudo_master">Чу-До Мастер (доп. занятия)</label>
          </div>
        <% } %>
        <% if (kind === 'graduate') { %>
          <div class="form-check">
            <input type="checkbox" name="is_featured" id="is_featured" <%= player && player.is_featured ? 'checked' : '' %>>
            <label for="is_featured">Показывать на главной</label>
          </div>
        <% } %>
        <div class="btn-group">
          <button type="submit" class="btn btn--primary">Сохранить</button>
          <a href="<%= kind === 'graduate' ? '/admin/graduates' : '/admin/players' %>" class="btn btn--outline">Отмена</a>
        </div>
      </form>
      <% if (player) { %>
        <form method="post" action="/admin/players/<%= player.id %>/delete" style="margin-top:0.75rem" onsubmit="return confirm('<%= kind === 'graduate' ? 'Удалить этого воспитанника?' : 'Удалить этого игрока?' %>')">
          <button type="submit" class="btn btn--danger">Удалить</button>
        </form>
      <% } %>
      </div>
    </div>
  </div>
  <script src="/js/admin-word-editor.js"></script>
</body>
</html>
