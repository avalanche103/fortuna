<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('../partials/fonts') %>
  <%- include('../partials/admin-favicon') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <div>
          <h1><%= title %></h1>
          <% if (month) { %><p class="admin-subtitle"><%= monthName %> <%= month.year %></p><% } %>
        </div>
        <div class="btn-group">
          <a class="btn btn--outline" href="/admin/schedule/locations">Площадки</a>
          <% if (month) { %>
            <a class="btn btn--secondary" href="/raspisanie?year=<%= month.year %>&month=<%= month.month %>" target="_blank">Предпросмотр</a>
          <% } %>
        </div>
      </div>

      <% if (saved) { %><div class="alert alert--success">Расписание сохранено.</div><% } %>

      <section class="schedule-admin-tools">
        <form action="/admin/schedule" method="get" class="schedule-admin-inline">
          <label for="schedule-month">Открыть месяц</label>
          <select id="schedule-month" onchange="if(this.value) location.href=this.value">
            <option value="">Выберите месяц</option>
            <% months.forEach(function(item) { %>
              <option value="/admin/schedule?year=<%= item.year %>&month=<%= item.month %>" <%= month && item.id === month.id ? 'selected' : '' %>>
                <%= MONTH_NAMES[item.month - 1] %> <%= item.year %>
              </option>
            <% }); %>
          </select>
        </form>

        <form action="/admin/schedule/month" method="post" class="schedule-admin-create">
          <strong>Создать месяц</strong>
          <input type="number" name="year" min="2000" max="2100" value="<%= new Date().getFullYear() %>" required aria-label="Год">
          <select name="month" required aria-label="Месяц">
            <% MONTH_NAMES.forEach(function(name, index) { %>
              <option value="<%= index + 1 %>" <%= index === new Date().getMonth() ? 'selected' : '' %>><%= name %></option>
            <% }); %>
          </select>
          <select name="copy_from" aria-label="Скопировать расписание">
            <option value="">Без копирования</option>
            <% months.forEach(function(item) { %>
              <option value="<%= item.id %>">Копировать: <%= MONTH_NAMES[item.month - 1] %> <%= item.year %></option>
            <% }); %>
          </select>
          <button class="btn btn--primary" type="submit">Создать</button>
        </form>
      </section>

      <% if (!month) { %>
        <div class="form-card"><p>Создайте первый месяц расписания.</p></div>
      <% } else { %>
        <%
          const entryBySlot = new Map();
          entries.forEach(function(entry) { entryBySlot.set(entry.day + ':' + entry.group_id, entry); });
          const textColor = function(color) {
            const match = /^#([0-9a-f]{6})$/i.exec(color || '');
            if (!match) return '#ffffff';
            const value = parseInt(match[1], 16);
            const brightness = (((value >> 16) & 255) * 299 + ((value >> 8) & 255) * 587 + (value & 255) * 114) / 1000;
            return brightness > 155 ? '#102451' : '#ffffff';
          };
          const normalizeAdminTime = function(value) {
            const raw = String(value || '').trim().replace(',', '.').replace('.', ':');
            const match = /^(\d{1,2}):([0-5]\d)(?::[0-5]\d)?$/.exec(raw);
            if (!match) return raw;
            return String(Number(match[1])).padStart(2, '0') + ':' + match[2];
          };
        %>
        <form action="/admin/schedule/<%= month.year %>/<%= month.month %>" method="post" id="schedule-form">
          <div class="schedule-admin-scroll">
            <table class="schedule-admin-grid">
              <thead>
                <tr>
                  <th class="schedule-admin-day">Дата</th>
                  <% groups.forEach(function(group) { %><th><%= group.name %></th><% }); %>
                </tr>
              </thead>
              <tbody>
                <% for (let day = 1; day <= daysInMonth; day += 1) {
                  const date = new Date(Date.UTC(month.year, month.month - 1, day));
                  const weekday = new Intl.DateTimeFormat('ru-RU', { weekday: 'short', timeZone: 'UTC' }).format(date);
                %>
                  <tr>
                    <th class="schedule-admin-day"><span><%= day %></span><small><%= weekday %></small></th>
                    <% groups.forEach(function(group) {
                      const slot = entryBySlot.get(day + ':' + group.id);
                      const start = slot && slot.time_start ? normalizeAdminTime(slot.time_start) : '';
                      const finish = slot && slot.time_end ? normalizeAdminTime(slot.time_end) : '';
                      const isDouble = slot && Number(slot.is_double) === 1;
                      const start2 = slot && slot.time_start_2 ? normalizeAdminTime(slot.time_start_2) : '';
                      const finish2 = slot && slot.time_end_2 ? normalizeAdminTime(slot.time_end_2) : '';
                      const location = slot && slot.location_id ? locations.find(function(item) { return item.id === slot.location_id; }) : null;
                      const location2 = slot && slot.location_id_2 ? locations.find(function(item) { return item.id === slot.location_id_2; }) : null;
                      const color = location ? location.color : '#6b7280';
                      const timeLabel = start
                        ? start + (finish ? '–' + finish : '') + (isDouble && start2 ? ' / ' + start2 + (finish2 ? '–' + finish2 : '') : '')
                        : '';
                      const locationLabel = [
                        location ? location.name : (slot ? 'Без площадки' : ''),
                        isDouble ? (location2 ? location2.name : 'Без площадки') : ''
                      ].filter(Boolean).join(' · ');
                    %>
                      <td class="schedule-admin-cell"
                          data-day="<%= day %>"
                          data-group="<%= group.id %>"
                          data-date-label="<%= day %> <%= monthName.toLowerCase() %>, <%= weekday %>"
                          data-group-label="<%= group.name %>">
                        <input class="slot-start" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][time_start]" value="<%= start %>">
                        <input class="slot-end" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][time_end]" value="<%= finish %>">
                        <input class="slot-location" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][location_id]" value="<%= slot && slot.location_id ? slot.location_id : '' %>">
                        <input class="slot-double" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][is_double]" value="<%= isDouble ? '1' : '' %>">
                        <input class="slot-start-2" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][time_start_2]" value="<%= start2 %>">
                        <input class="slot-end-2" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][time_end_2]" value="<%= finish2 %>">
                        <input class="slot-location-2" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][location_id_2]" value="<%= slot && slot.location_id_2 ? slot.location_id_2 : '' %>">
                        <input class="slot-note" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][note]" value="<%= slot && slot.note ? slot.note : '' %>">
                        <input class="slot-note-2" type="hidden" name="slots[d<%= day %>][g<%= group.id %>][note_2]" value="<%= slot && slot.note_2 ? slot.note_2 : '' %>">
                        <button type="button"
                                class="schedule-slot-card <%= slot ? 'has-value' : '' %> <%= isDouble ? 'is-double' : '' %>"
                                <% if (slot) { %>style="--slot-color:<%= color %>;--slot-text:<%= textColor(color) %>"<% } %>>
                          <span class="schedule-slot-card__time"><%= timeLabel || (slot ? 'Настроено' : '+ Добавить') %></span>
                          <span class="schedule-slot-card__location"><%= locationLabel %></span>
                          <span class="schedule-slot-card__note"><%= [slot && slot.note, isDouble && slot && slot.note_2].filter(Boolean).join(' / ') %></span>
                        </button>
                      </td>
                    <% }); %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <dialog class="schedule-editor" id="schedule-editor" aria-labelledby="schedule-editor-title">
            <div class="schedule-editor__heading">
              <div>
                <span id="schedule-editor-date"></span>
                <h2 id="schedule-editor-title">Занятие</h2>
              </div>
              <button type="button" class="schedule-editor__close" aria-label="Закрыть">×</button>
            </div>
            <div class="schedule-editor__body">
              <div class="schedule-editor__shift">
                <div class="schedule-editor__shift-title">Первая смена</div>
                <div class="schedule-editor__times">
                  <label>Начало<input type="time" id="editor-start"></label>
                  <span>—</span>
                  <label>Окончание<input type="time" id="editor-end"></label>
                </div>
                <label>Площадка
                  <select id="editor-location">
                    <option value="" data-color="#6b7280">Без площадки</option>
                    <% locations.forEach(function(item) { %>
                      <option value="<%= item.id %>" data-color="<%= item.color %>">
                        <%= item.name %><%= item.is_active ? '' : ' (неактивна)' %>
                      </option>
                    <% }); %>
                  </select>
                </label>
                <label>Примечание<input type="text" id="editor-note" maxlength="200" placeholder="Например, взять форму"></label>
              </div>
              <label class="schedule-editor__double-toggle">
                <input type="checkbox" id="editor-double">
                <span>Двойное занятие</span>
              </label>
              <div class="schedule-editor__shift schedule-editor__shift--second" id="editor-second-shift" hidden>
                <div class="schedule-editor__shift-title">Вторая смена</div>
                <div class="schedule-editor__times">
                  <label>Начало<input type="time" id="editor-start-2"></label>
                  <span>—</span>
                  <label>Окончание<input type="time" id="editor-end-2"></label>
                </div>
                <label>Площадка
                  <select id="editor-location-2">
                    <option value="" data-color="#6b7280">Без площадки</option>
                    <% locations.forEach(function(item) { %>
                      <option value="<%= item.id %>" data-color="<%= item.color %>">
                        <%= item.name %><%= item.is_active ? '' : ' (неактивна)' %>
                      </option>
                    <% }); %>
                  </select>
                </label>
                <label>Примечание<input type="text" id="editor-note-2" maxlength="200" placeholder="Например, взять форму"></label>
              </div>
              <div class="schedule-editor__actions-secondary">
                <button type="button" class="schedule-editor__copy">Скопировать предыдущий день</button>
                <button type="button" class="schedule-editor__clear">Очистить занятие</button>
              </div>
            </div>
            <div class="schedule-editor__footer">
              <button type="button" class="btn btn--outline schedule-editor__cancel">Отмена</button>
              <button type="button" class="btn btn--primary schedule-editor__apply">Готово</button>
            </div>
          </dialog>

          <div class="schedule-savebar">
            <span id="schedule-dirty">Изменений нет</span>
            <button class="btn btn--primary" type="submit">Сохранить расписание</button>
          </div>
        </form>
      <% } %>
    </main>
  </div>
  <script src="/js/admin-schedule.js"></script>
</body>
</html>
