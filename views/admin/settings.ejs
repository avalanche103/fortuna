<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('../partials/fonts') %>
  <%- include('../partials/admin-favicon') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <div class="admin-main">
      <h1><%= title %></h1>
      <form class="form-card" method="post" action="/admin/settings">
        <div class="form-group">
          <label>Бегущая строка</label>
          <input type="text" name="banner_text" value="<%= settings.banner_text || '' %>">
        </div>
        <div class="form-group">
          <label>Телефоны</label>
          <input type="text" name="banner_phones" value="<%= settings.banner_phones || '' %>">
        </div>
        <div class="form-group">
          <label>Часы работы</label>
          <input type="text" name="banner_hours" value="<%= settings.banner_hours || '' %>">
        </div>
        <div class="form-group">
          <label>Заголовок блока набора</label>
          <input type="text" name="recruitment_title" value="<%= settings.recruitment_title || '' %>">
        </div>
        <div class="form-group">
          <label>Подзаголовок набора</label>
          <input type="text" name="recruitment_subtitle" value="<%= settings.recruitment_subtitle || '' %>">
        </div>
        <div class="form-group">
          <label>Текст набора</label>
          <textarea name="recruitment_body" class="js-word-editor" data-mode="text"><%= settings.recruitment_body || '' %></textarea>
        </div>
        <div class="form-group">
          <label>Яндекс.Метрика — номер счётчика</label>
          <input type="text" name="ym_counter_id" inputmode="numeric" pattern="[0-9]*" value="<%= settings.ym_counter_id || '111995843' %>" placeholder="например 111995843">
          <p class="form-hint">Создайте счётчик на <a href="https://metrika.yandex.ru/" target="_blank" rel="noopener">metrika.yandex.ru</a> для fcfortuna.by и вставьте номер. После этого в подвале появится информер для посетителей.</p>
        </div>
        <button type="submit" class="btn btn--primary">Сохранить</button>
      </form>
    </div>
  </div>
  <script src="/js/admin-word-editor.js"></script>
</body>
</html>
